# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
# 3307, not 3306: this machine's Homebrew mysql@8.0 already holds 3306.
DB_PORT=3307
DB_NAME=courier_db
DB_USERNAME=courier
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT --------------------------------------------------------------------
# Minimum 32 bytes; the app refuses to start with anything shorter.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- App --------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

# --- docker-compose.yml host port mappings (root compose, not docker/) ------
# 8080/8081/4200 are already taken on this machine — see MEMORY.
BACKEND_PORT=8091
WEB_PORT=8090
