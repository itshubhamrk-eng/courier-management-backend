# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
# 3307, not 3306: this machine's Homebrew mysql@8.0 already holds 3306.
DB_PORT=3307
DB_NAME=courier_db
DB_USERNAME=courier
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT --------------------------------------------------------------------
# Minimum 32 bytes; the app refuses to start with anything shorter.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Secrets encryption -------------------------------------------------------
# Only needed once a company saves its own Razorpay key secret (CompanyRazorpayConfig) —
# fails at that point if unset, not at startup. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# --- App --------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

# --- POD file storage (S3) ---------------------------------------------------
# Leave AWS_S3_ENABLED=false to fail closed (uploads rejected, URL field still works).
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# SDK's default credentials provider chain; unneeded if the host has an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Branch geocoding (Nominatim, free/keyless) -----------------------------
# On by default. A miss or GEOCODING_ENABLED=false just leaves a branch's
# latitude/longitude null — never blocks creating it.
GEOCODING_ENABLED=true
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real identifying User-Agent on every request.
GEOCODING_USER_AGENT=courier-management-app (contact: set GEOCODING_USER_AGENT)

# --- Branch-to-branch routing (OSRM, free/keyless) --------------------------
# On by default. Public OSRM demo server, not for production traffic — self-host
# before real volume.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org

# --- Payment gateway (Razorpay) ----------------------------------------------
# Off by default: no gateway configured means online recharge fails closed (422),
# manual credit by a company admin still works. Enabling without both keys fails
# at startup, not at the first recharge. Per-company override: CompanyRazorpayConfig.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1

# --- Communication Center (WhatsApp/SMS/Email) -------------------------------
# Each channel defaults to log-only — no dev-environment vendor account exists to call
# for real. Per-company Phone Number ID/API URL/from-email/secret live in the
# communication_setting table regardless of these flags; these only select whether this
# deployment makes real outbound HTTP/SMTP calls at all. Enabling WhatsApp/SMS without a
# company having configured its own credentials just fails that company's own sends
# (ProviderSendException -> FAILED, retried), not a startup failure — credentials are
# per-company here, unlike Razorpay's platform-wide key pair.
COMMUNICATION_WHATSAPP_ENABLED=false
COMMUNICATION_SMS_ENABLED=false
COMMUNICATION_EMAIL_ENABLED=false
# Email additionally needs platform SMTP — Spring Boot's own env vars, picked up with no
# extra wiring. Leaving SPRING_MAIL_HOST unset with COMMUNICATION_EMAIL_ENABLED=true
# fails at startup, not at the first send.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- docker-compose.yml host port mappings (root compose, not docker/) ------
# 8080/8081/4200 are already taken on this machine — see MEMORY.
BACKEND_PORT=8091
WEB_PORT=8090
